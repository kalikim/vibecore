{
  "name": "vibecore",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Local-first application orchestration for AI-assisted developers",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/prepare-assets.mjs && tsc -b",
    "check": "pnpm typecheck && pnpm test && pnpm test:cli",
    "typecheck": "node scripts/prepare-assets.mjs && tsc -b --pretty false",
    "test:cli": "pnpm build && node --test tests/cli.smoke.mjs",
    "test:package": "pnpm build && node scripts/verify-package.mjs",
    "test:tarballs": "pnpm build && node scripts/verify-tarballs.mjs",
    "test:nginx": "pnpm build && node scripts/verify-nginx.mjs",
    "test": "vitest run",
    "vibe": "pnpm build && node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
